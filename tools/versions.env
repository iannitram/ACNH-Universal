# Versions of the tools and libraries the build downloads (#328). One file, read by:
#   - Prepare (crates/core/src/prepare/tools.rs, embedded at build time),
#   - CI (.github/workflows/check.yml: `grep -E '^[A-Z0-9_]+=' tools/versions.env >> "$GITHUB_ENV"`; GITHUB_ENV rejects comment lines),
#   - tools/build_ios.sh and tools/build_android.sh (`. tools/versions.env`).
# Plain KEY=value lines, no quoting, no spaces. Every download these name needs a SHA-256 in
# tools/downloads.sha256; tools/check_pins.sh checks both files agree.
#
# One pair differs on purpose today (what each place builds against), so it carries two keys:
#   SDL3 (Rust player, Windows Prepare, CI) vs SDL3_IOS (static build for iOS).
# Making a pair one version changes what gets built; do that in its own change.
SDL3=3.4.16
SDL3_IOS=3.4.18
MOLTENVK=1.3.0
VK_HEADERS=1.4.357
LLVM=23.1.3
IMGUI=1.91.9
RYUBING=a82350bb77
DOTNET=10.0.401
FFX=v2.4.0
DLSS=v310.9.16
CMAKE_VERSION=4.4.5
NINJA_VERSION=1.13.2
