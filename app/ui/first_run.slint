import { InputHints } from "hints.slint";
import { VerticalBox, HorizontalBox } from "std-widgets.slint";
export component FirstRunPage inherits Rectangle {
    in property <int> input-device;
    // "Guided setup" in the first run, "Save sync" when Settings opens the same pages.
    in property <string> heading: "Guided setup";
    // Keys across one row of the open keypad (the address pad's six, the keyboard's ten).
    in property <int> columns: 6;
    // The on-screen keyboard is open: its prompts say Press key and Leave editor.
    in property <bool> editor;
    in property <string> title;
    in property <string> choice;
    in property <string> position;
    in property <bool> busy;
    in property <int> progress;
    in property <bool> keypad;
    in property <bool> cancel-available;
    in property <string> message;
    in property <[string]> choices;
    in property <int> focus-index;
    callback choose(int);
    callback previous();
    callback next();
    callback accept();
    callback back();
    background: #172821;
    VerticalBox {
        padding: 32px;
        spacing: 18px;
        Text { text: root.heading; color: white; font-size: 30px; }
        Text { text: root.title; color: white; font-size: 24px; wrap: word-wrap; }
        if root.message != "": Text { text: root.message; color: #f7d681; wrap: word-wrap; }
        Text { text: root.busy ? "Working…" : root.position; color: #f7d681; font-size: 20px; }
        if root.progress >= 0: Rectangle {
            min-height: 12px;
            background: #354a40;
            Rectangle { width: parent.width * root.progress / 100; height: parent.height; background: #f7d681; }
        }
        if !root.busy && !root.keypad: Rectangle {
            min-height: 60px;
            border-width: 3px;
            border-color: #f7d681;
            border-radius: 8px;
            background: #29453a;
            Text { text: root.choice; color: white; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.accept(); } }
        }
        if root.keypad: Rectangle {
            min-height: Math.ceil(root.choices.length / root.columns) * 42px;
            for text[index] in root.choices: Rectangle {
                width: (parent.width - (root.columns - 1) * 6px) / root.columns;
                height: 36px;
                x: Math.mod(index, root.columns) * (self.width + 6px);
                y: Math.floor(index / root.columns) * 42px;
                border-width: 2px;
                border-color: index == root.focus-index ? #f7d681 : transparent;
                border-radius: 6px;
                background: #29453a;
                Text { text: text; color: white; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.choose(index); } }
            }
        }
        HorizontalBox {
            spacing: 10px;
            for item[index] in ["Previous", "Next", "Select", root.busy ? "Cancel" : "Back"]: Rectangle {
                visible: (index == 3 && (!root.busy || root.cancel-available)) || (index != 3 && !root.busy && !root.keypad);
                min-height: 54px;
                border-radius: 6px;
                background: #29453a;
                Text { text: item; color: white; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { if index == 0 { root.previous(); } else if index == 1 { root.next(); } else if index == 2 { root.accept(); } else { root.back(); } } }
            }
        }
        InputHints {
            device: root.input-device;
            move-label: root.busy ? "" : "Move";
            select-label: root.busy ? "" : root.editor ? (root.input-device == 0 ? "Done" : "Press key") : "Select";
            back-label: root.busy ? (root.cancel-available ? "Cancel" : "") : root.editor ? "Leave editor" : "Back";
        }
    }
}
