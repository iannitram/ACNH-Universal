import { ContinuePage } from "continue.slint";

export component MainWindow inherits Window {
    title: "ACNH Universal";
    min-width: 560px;
    min-height: 360px;
    preferred-width: 720px;
    preferred-height: 480px;
    background: #172821;

    in-out property<int> selected: 0;
    in-out property<string> selection: "Continue";
    in-out property<string> status: "Ready to sync and play.";
    callback activate;

    ContinuePage {
        status_message: root.status;
        play_clicked => { root.activate(); }
    }
}
