import { SavesPage } from "saves.slint";
import { InputHints } from "hints.slint";
import { FirstRunPage } from "first_run.slint";
import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { FleetPage, FleetEntry } from "fleet.slint";
import { AboutPage, CreditEntry, FixEntry } from "about.slint";
import { ContinuePage, ContinueView, CardView, PadTarget } from "continue.slint";

export { ContinueView, CardView, PadTarget, CreditEntry, FixEntry, FleetEntry }
export enum SettingsControl { ptbr, speedfix, relay-sign-in, relay-off, back }

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected;
    callback activate();

    min-height: 48px;
    border-width: 2px;
    border-color: root.selected ? #f7d681 : transparent;
    border-radius: 6px;
    background: touch.has-hover ? #29453a : #22382e;

    HorizontalBox {
        padding: 10px;
        Text { text: root.label; color: white; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: root.value; color: #f7d681; vertical-alignment: center; }
    }

    touch := TouchArea { clicked => { root.activate(); } }
}

// The launcher window. It shows the Continue page and hands every key and click to Rust:
// `view` is `ContinuePageVm::view()`, `clicked` is a click or tap on a button, and `key` is
// a key press (true when it was one of the launcher's keys).
export component MainWindow inherits Window {
    in property <ContinueView> view;
    in property <int> input-device;
    // True while this window has the keyboard focus: the pad is ignored otherwise.
    out property <bool> window-focused: keys.has-focus;
    callback pointer-used();
    in property <image> card-picture;
    in property <bool> first-run-open;
    in property <string> first-run-heading: "Guided setup";
    in property <int> first-run-columns: 6;
    in property <bool> first-run-editor;
    // Settings opened the save sync pages (they draw with the first run's page).
    in property <bool> relay-flow-open;
    in property <string> first-run-title;
    in property <string> first-run-choice;
    in property <string> first-run-position;
    in property <bool> first-run-busy;
    in property <int> first-run-progress: -1;
    in property <bool> first-run-keypad;
    in property <bool> first-run-cancel-available;
    in property <string> first-run-message;
    in property <[string]> first-run-choices;
    in property <int> first-run-focus-index;
    callback first-run-nav(int);
    callback first-run-choose(int);
    // What About shows (`AboutVm`), set once at start.
    in property <string> about-upstream;
    in property <string> about-slint-notice;
    in property <[CreditEntry]> about-credits;
    in property <[FixEntry]> about-fixes;
    in property <[FleetEntry]> fleet-rows;
    in property <string> fleet-message;
    in property <string> fleet-comparison;
    in property <string> fleet-position;
    in-out property <int> fleet-offset;
    in property <bool> fleet-has-previous;
    in property <bool> fleet-has-next;
    in property <bool> hub-available;
    in property <string> hub-line;
    in property <string> hub-code;
    in property <string> hub-button;
    callback hub-toggle();
    in property <string> saves-island;
    in property <[string]> saves-backups;
    in property <string> saves-message;
    in property <string> saves-position;
    in-out property <int> saves-offset;
    in property <bool> saves-has-previous;
    in property <bool> saves-has-next;
    callback saves-scroll(int);
    in property <string> saves-relay;
    in property <bool> saves-sync-enabled;
    callback saves-sync-now();
    in property <bool> ptbr;
    in property <bool> speedfix;
    in property <SettingsControl> settings-focus: SettingsControl.ptbr;
    in property <string> settings-error;
    in property <bool> settings-relay-available;
    in property <string> settings-relay-summary;
    in property <string> settings-relay-sign-in;
    in property <bool> settings-relay-has-off;
    in property <string> settings-relay-off;
    in property <string> settings-relay-message;
    callback settings-relay-activate(SettingsControl);
    callback fleet-scroll(int);
    callback set-ptbr(bool);
    callback set-speedfix(bool);
    callback clicked(PadTarget);
    callback key(string) -> bool;

    title: "ACNH Universal";
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 720px;
    min-height: 480px;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            return root.key(event.text) ? EventResult.accept : EventResult.reject;
        }

        TouchArea {
            clicked => { root.pointer-used(); }
        }

        ContinuePage {
            view: root.view;
            input-device: root.input-device;
            card-picture: root.card-picture;
            clicked(target) => {
                root.pointer-used();
                root.clicked(target);
            }
        }

        if root.view.settings-open: Rectangle {
            background: #172821;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "Settings"; color: white; font-size: 28px; }
                Text { text: "Prepare again to apply these changes to your build."; color: white; }
                SettingsRow {
                    label: "Brazilian Portuguese fan translation";
                    value: root.ptbr ? "On" : "Off";
                    selected: root.settings-focus == SettingsControl.ptbr;
                    activate => { root.pointer-used(); root.set-ptbr(!root.ptbr); }
                }
                SettingsRow {
                    label: "60 FPS SpeedFix (3.0.2 and 3.0.3)";
                    value: root.speedfix ? "On" : "Off";
                    selected: root.settings-focus == SettingsControl.speedfix;
                    activate => { root.pointer-used(); root.set-speedfix(!root.speedfix); }
                }
                if root.settings-error != "": Text { text: root.settings-error; color: #f7d681; }
                if root.settings-relay-available: Text { text: root.settings-relay-summary; color: white; wrap: word-wrap; }
                if root.settings-relay-available: SettingsRow {
                    label: root.settings-relay-sign-in;
                    selected: root.settings-focus == SettingsControl.relay-sign-in;
                    activate => { root.pointer-used(); root.settings-relay-activate(SettingsControl.relay-sign-in); }
                }
                if root.settings-relay-available && root.settings-relay-has-off: SettingsRow {
                    label: root.settings-relay-off;
                    selected: root.settings-focus == SettingsControl.relay-off;
                    activate => { root.pointer-used(); root.settings-relay-activate(SettingsControl.relay-off); }
                }
                if root.settings-relay-message != "": Text { text: root.settings-relay-message; color: #f7d681; wrap: word-wrap; }
                SettingsRow {
                    label: "Back";
                    selected: root.settings-focus == SettingsControl.back;
                    activate => { root.pointer-used(); root.clicked(PadTarget.back); }
                }
                InputHints { device: root.input-device; }
            }
        }

        if root.first-run-open || root.relay-flow-open: FirstRunPage {
            input-device: root.input-device;
            heading: root.first-run-heading;
            columns: root.first-run-columns;
            editor: root.first-run-editor;
            title: root.first-run-title;
            choice: root.first-run-choice;
            position: root.first-run-position;
            busy: root.first-run-busy;
            progress: root.first-run-progress;
            keypad: root.first-run-keypad;
            cancel-available: root.first-run-cancel-available;
            message: root.first-run-message;
            choices: root.first-run-choices;
            focus-index: root.first-run-focus-index;
            choose(index) => { root.pointer-used(); root.first-run-choose(index); }
            previous => { root.pointer-used(); root.first-run-nav(0); }
            next => { root.pointer-used(); root.first-run-nav(1); }
            accept => { root.pointer-used(); root.first-run-nav(2); }
            back => { root.pointer-used(); root.first-run-nav(3); }
        }

        if root.view.fleet-open && !root.first-run-open: FleetPage {
            input-device: root.input-device;
            rows: root.fleet-rows;
            message: root.fleet-message;
            comparison: root.fleet-comparison;
            position: root.fleet-position;
            has-previous: root.fleet-has-previous;
            has-next: root.fleet-has-next;
            hub-available: root.hub-available;
            hub-line: root.hub-line;
            hub-code: root.hub-code;
            hub-button: root.hub-button;
            hub-toggle => { root.pointer-used(); root.hub-toggle(); }
            back => { root.pointer-used(); root.clicked(PadTarget.back); }
            previous => { root.pointer-used(); root.fleet-scroll(-1); }
            next => { root.pointer-used(); root.fleet-scroll(1); }
        }

        if root.view.saves-open && !root.first-run-open: SavesPage {
            input-device: root.input-device;
            island: root.saves-island;
            backups: root.saves-backups;
            message: root.saves-message;
            position: root.saves-position;
            has-previous: root.saves-has-previous;
            has-next: root.saves-has-next;
            relay: root.saves-relay;
            sync-enabled: root.saves-sync-enabled;
            back => { root.pointer-used(); root.clicked(PadTarget.back); }
            previous => { root.pointer-used(); root.saves-scroll(-1); }
            next => { root.pointer-used(); root.saves-scroll(1); }
            sync-now => { root.pointer-used(); root.saves-sync-now(); }
        }

        // The About overlay: opened by the About entry on the Continue page, closed by Back.
        if root.view.about-open && !root.first-run-open: AboutPage {
            input-device: root.input-device;
            upstream-credit: root.about-upstream;
            slint-notice: root.about-slint-notice;
            credits: root.about-credits;
            offered-fixes: root.about-fixes;
            back => {
                root.pointer-used();
                root.clicked(PadTarget.back);
            }
        }
    }
}
