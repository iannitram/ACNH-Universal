import { Button, VerticalBox } from "std-widgets.slint";
import { AboutPage, CreditEntry, FixEntry } from "about.slint";
export { CreditEntry, FixEntry }

export component MainWindow inherits Window {
    title: "ACNH Universal";
    min-width: 560px;
    min-height: 360px;
    preferred-width: 720px;
    preferred-height: 480px;

    in-out property<int> selected: 0;
    in-out property<string> selection: "Continue";
    in-out property<string> status: "Ready to sync and play.";
    in property<string> about-upstream;
    in property<string> about-slint-notice;
    in property<[CreditEntry]> about-credits;
    in property<[FixEntry]> about-fixes;
    callback activate;

    VerticalBox {
        padding: 32px;
        spacing: 16px;

        if root.selection != "About": VerticalBox {
            spacing: 16px;

            Text {
                text: "Continue";
                font-size: 30px;
                color: #f4f0e8;
            }
            Text {
                text: "ACNH Universal  ·  " + root.selection;
                font-size: 18px;
                color: #b8c7bb;
            }
            Rectangle {
                background: #283d35;
                border-radius: 12px;
                VerticalBox {
                    spacing: 8px;
                    Text { text: "Your island"; font-size: 22px; color: #f4f0e8; }
                    Text { text: "Select Continue to sync and play"; color: #d2dfd5; }
                    Text { text: root.status; color: #b8c7bb; }
                }
            }
            Button {
                text: root.selected == 0 ? "▶  Continue" : "Continue";
                clicked => { root.activate(); }
            }
        }

        if root.selection == "About": AboutPage {
            upstream-credit: root.about-upstream;
            slint-notice: root.about-slint-notice;
            credits: root.about-credits;
            offered-fixes: root.about-fixes;
        }

        Text {
            text: "D-pad / stick to browse     A to activate     B to go back";
            color: #b8c7bb;
        }
    }
    background: #172821;
}
