<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac app's Info.plist. Its version is filled in by .github/workflows/release.yml (the
     release's app) and by crates/core/src/assemble.rs (the bundle made from a checkout). -->
<plist version="1.0"><dict>
<key>CFBundleName</key><string>ACNH Universal</string>
<key>CFBundleIdentifier</key><string>io.github.iannitram.acnh-universal</string>
<key>CFBundleExecutable</key><string>acnh-app</string>
<key>CFBundleIconFile</key><string>acnhrecomp</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>@VERSION@</string>
<key>NSHighResolutionCapable</key><true/>
<key>LSApplicationCategoryType</key><string>public.app-category.simulation-games</string>
<!-- The launcher waits behind the full-screen game and must take the exit push's result as soon
     as it comes: App Nap would throttle its timer while the game hides it. -->
<key>LSAppNapIsDisabled</key><true/>
<key>NSLocalNetworkUsageDescription</key><string>ACNH Universal syncs your island with your save server and finds build hubs on this network.</string>
</dict></plist>
